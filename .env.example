# ============================================================
# Autonomous Disruptive Intelligence Ecosystem
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to Git!
# ============================================================

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# --- Supabase ---
# Find these in your Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here

# --- Model Configuration ---
# Default models for each complexity tier
MODEL_STANDARD=claude-sonnet-4-6
MODEL_COMPLEX=claude-opus-4-6

# --- Venture ---
# Set this to your active venture name (must match a ventures table entry)
ACTIVE_VENTURE=Vision Correction Display
